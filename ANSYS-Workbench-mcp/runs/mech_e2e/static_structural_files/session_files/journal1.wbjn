geometry1 = system1.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="D:/Inventor_Export/stepped_shaft.stp")
Save(Overwrite=True)
model1 = system1.GetContainer(ComponentName="Model")
model1.Edit(Interactive=False)
