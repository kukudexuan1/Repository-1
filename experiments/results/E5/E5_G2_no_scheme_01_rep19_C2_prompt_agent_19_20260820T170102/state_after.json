    "calc#2": {
      "record_id": "calc#2",
      "title": "齿轮应力循环次数计算（校核寿命系数 K_HN/K_FN=1 的依据）",
      "formula_id": "",
      "expression": "（沙箱脚本，见 script 字段）",
      "inputs": {},
      "substitution": "",
      "result": {
        "Lh_hour": {
          "value": 48000.0,
          "unit": "hour"
        },
        "N1": {
          "value": 4147200000.0,
          "unit": ""
        },
        "N2": {
          "value": 1036800000.0,
          "unit": ""
        }
      },
      "criterion": "N1、N2 均 > 1e7，则接触与弯曲寿命系数 K_HN=K_FN=1",
      "verdict": "n/a",
      "margin_percent": null,
      "source": "机械设计（第十版）式 10-24：N = 60·n·j·Lh；接触/弯曲寿命基数 N0≈1e7",
      "engine": "sympy",
      "depends_on": [
        "calc#1"
      ],
      "stale": false,
      "stale_reason": "",
      "notes": "",
      "script": "\nLh = 16 * 300 * 10   # hour: 每天16h × 每年300天 × 10年\nN1 = 60 * 1440 * 1 * Lh   # 小齿轮循环次数, j=1 (单侧啮合)\nN2 = N1 / 4               # 大齿轮循环次数\noutputs = {'Lh_hour': Lh, 'N1': N1, 'N2': N2}\n",
      "created_at": "2026-08-20T17:02:44.204555Z"
    },
    "calc#3": {
      "record_id": "calc#3",
