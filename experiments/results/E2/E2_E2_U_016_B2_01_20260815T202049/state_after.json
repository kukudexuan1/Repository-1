      "script": "Mb = 180  # N·m\nW = 12271  # mm³\n\n# 正确做法：N·m → N·mm，乘 1000\nMb_Nmm = Mb * 1000  # = 180,000 N·mm\nsigma_b_correct = Mb_Nmm / W  # MPa (N/mm²)\n\n# 错误做法（漏乘 1000）\nsigma_b_wrong = Mb / W  # 单位不一致，结果小 1000 倍\n\noutputs = {\n    'Mb_Nmm': Mb_Nmm,\n    'sigma_b_correct_MPa': sigma_b_correct,\n    'sigma_b_wrong': sigma_b_wrong,\n    'ratio': sigma_b_correct / sigma_b_wrong\n}",
