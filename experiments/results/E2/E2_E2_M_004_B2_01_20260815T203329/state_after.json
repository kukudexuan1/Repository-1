      "script": "# 轴承寿命计算 ISO 281 / GB/T 6391\n# 球轴承 ε=3, 滚子轴承 ε=10/3\n\nC = 32000      # 额定动载荷 N\nP = 9200       # 当量动载荷 N\nn = 480        # 转速 r/min\n\n# 球轴承\nepsilon_ball = 3\nL10_ball = (C / P) ** epsilon_ball * 1e6    # 基本额定寿命，转\nL10h_ball = L10_ball / (60 * n)              # 小时\n\n# 滚子轴承\nepsilon_roller = 10/3\nL10_roller = (C / P) ** epsilon_roller * 1e6\nL10h_roller = L10_roller / (60 * n)\n\noutputs = {\n    'L10_ball': L10_ball,\n    'L10h_ball': L10h_ball,\n    'L10_roller': L10_roller,\n    'L10h_roller': L10h_roller,\n    'C_over_P': C / P\n}",
