      "script": "# 输入参数\nP_in = 7.5        # kW，输入功率\nn1 = 960          # r/min，输入转速\ni = 3.15          # 传动比\neta = 0.97        # 效率\n\n# 输入扭矩 T1 (N·mm)\nT1 = 9550000 * P_in / n1\n\n# 输出转速 n2 (r/min)\nn2 = n1 / i\n\n# 输出功率 P2 (kW)\nP2 = P_in * eta\n\n# 输出扭矩 T2 (N·mm)，两种算法互相验证\nT2_method1 = T1 * i * eta          # 扭矩放大 × 效率\nT2_method2 = 9550000 * P2 / n2     # 由输出功率与输出转速求\n\noutputs = {\n    'T1_Nm': T1 / 1000,\n    'n2': n2,\n    'P2': P2,\n    'T2_Nm': T2_method1 / 1000,\n    'T2_check_Nmm': T2_method2\n}",
