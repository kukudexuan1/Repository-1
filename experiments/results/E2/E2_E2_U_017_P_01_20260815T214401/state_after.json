      "script": "# 扭转切应力 τ = T / Wp\n# 单位统一：T 从 N·m 转为 N·mm，Wp 为 mm³，结果 τ 为 MPa (N/mm²)\n\nT_Nm = 320.0        # N·m\nWp = 24543.0        # mm³\n\nT_Nmm = T_Nm * 1000.0   # 1 N·m = 1000 N·mm\n\ntau = T_Nmm / Wp         # N·mm / mm³ = N/mm² = MPa\n\noutputs = {\n    'T_Nmm': T_Nmm,\n    'Wp': Wp,\n    'tau_MPa': tau\n}",
