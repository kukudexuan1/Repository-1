      "script": "T_Nm = 320  # N·m\nWp_mm3 = 24543  # mm³\n\n# 统一单位：T 转为 N·mm，1 N·m = 1000 N·mm\nT_Nmm = T_Nm * 1000\n\n# 扭转切应力 τ = T / Wp (N·mm / mm³ = N/mm² = MPa)\ntau = T_Nmm / Wp_mm3\n\noutputs = {\n    'T_Nmm': T_Nmm,\n    'tau_MPa': tau\n}",
