    "margin_percent": null,
    "source": "机械设计（第十版）表 10-5 外齿轮齿形系数与应力校正系数（线性内插）",
    "engine": "sympy",
    "depends_on": [
      "z_1",
      "z_2"
    ],
    "stale": false,
    "stale_reason": "",
    "notes": "",
    "script": "\n# 机械设计（第十版）表10-5 外齿轮齿形系数 YFa 与应力校正系数 YSa（标准齿形 α=20°, ha*=1, c*=0.25）\n# 查表节点 (z, YFa, YSa)\ntable = [\n    (20, 2.80, 1.55),\n    (24, 2.65, 1.58),\n    (25, 2.62, 1.59),\n    (30, 2.52, 1.625),\n    (40, 2.40, 1.67),\n    (50, 2.32, 1.70),\n    (60, 2.28, 1.73),\n    (80, 2.22, 1.77),\n    (100, 2.18, 1.79),\n    (150, 2.14, 1.83),\n    (200, 2.12, 1.865),\n]\n\ndef interp(z):\n    for i in range(len(table)-1):\n        z0, y0, s0 = table[i]\n        z1, y1, s1 = table[i+1]\n        if z0 <= z <= z1:\n            t = (z - z0) / (z1 - z0)\n            return y0 + (y1-y0)*t, s0 + (s1-s0)*t\n    raise ValueError('z out of range')\n\nYFa1, YSa1 = interp(24)\nYFa2, YSa2 = interp(96)\noutputs = {\n    'YFa_z24': round(YFa1, 3),\n    'YSa_z24': round(YSa1, 3),\n    'YFa_z96': round(YFa2, 3),\n    'YSa_z96': round(YSa2, 3),\n}\n",
    "created_at": "2026-08-21T09:14:02.016590Z"
  },
