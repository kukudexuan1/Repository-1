# 环境变量配置示例

# ===== 主编排模型 API (DeepSeek) =====
DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_ENABLE_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# ===== 建模模型 (mcp-cad 工具编排) =====
QWEN_CODER_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CODER_API_KEY=your_dashscope_api_key
QWEN_CODER_MODEL=qwen3-coder-plus

# ===== 视觉模型 (图纸解析) =====
QWEN3_VL_PLUS_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN3_VL_PLUS_API_KEY=your_dashscope_api_key
QWEN3_VL_PLUS_MODEL=qwen3-vl-plus

# ===== 数学/仿真前后处理模型 (ANSYS) =====
QWEN_MATH_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MATH_API_KEY=your_dashscope_api_key
QWEN_MATH_MODEL=qwen3.5-plus

# ===== mcp-cad MCP Server (Inventor 建模) =====
# 重要：必须直接运行编译产物 exe，不要用 `dotnet run`
# （dotnet run 会把 MSBuild 编译日志打到 stdout，污染 JSONRPC 流）。
# 先构建一次：dotnet build src/McpCad.Server -c Release
MCPCAD_ENABLED=true
MCPCAD_COMMAND=<mcp-cad目录>/src/McpCad.Server/bin/Release/net8.0-windows/McpCad.Server.exe
MCPCAD_ARGS=
MCPCAD_CWD=<mcp-cad目录>
MCPCAD_INIT_TIMEOUT=90
MCPCAD_CALL_TIMEOUT=600
MCPCAD_EXPORT_DIR=D:/Inventor_Export

# ===== ansys-workbench MCP Server (有限元仿真) =====
ANSYS_MCP_ENABLED=true
ANSYS_MCP_COMMAND=python
ANSYS_MCP_ARGS=mcp_server.py
ANSYS_MCP_CWD=C:/Users/14170/Desktop/研究生课题/ANSYS-Workbench-mcp
ANSYS_MCP_INIT_TIMEOUT=60
ANSYS_MCP_CALL_TIMEOUT=3600
ANSYS_PROJECT_DIR=D:/ansys-workbench-mcp/runs/agent

# ANSYS 超时配置 (Workbench 冷启动需 1-2 分钟)
ANSYS_BRIDGE_START_WAIT=180
ANSYS_BRIDGE_TIMEOUT=60
ANSYS_LOG_MARKER_WAIT=1800

# ===== ANSYS 安装路径 (透传给 ansys-workbench MCP server) =====
ANSYS_WORKBENCH_MCP_HOME=C:/Users/14170/Desktop/研究生课题/ANSYS-Workbench-mcp
# Mechanical 只接受纯 ASCII 路径，项目目录含中文时必须提供该 scratch 目录
ANSYS_WORKBENCH_MCP_SCRATCH=C:/ansys-wb-mcp/ipc
ANSYS_RUNWB2=D:/Program Files/ANSYS Inc/v251/Framework/bin/Win64/RunWB2.exe
ANSYS_MECHANICAL=D:/Program Files/ANSYS Inc/v251/aisol/bin/winx64/AnsysWBU.exe
ANSYS_MAPDL=D:/Program Files/ANSYS Inc/v251/ansys/bin/winx64/ANSYS251.exe
ANSYS_FLUENT=D:/Program Files/ANSYS Inc/v251/fluent/ntbin/win64/fluent.exe
ANSYS_CFX_SOLVE=D:/Program Files/ANSYS Inc/v251/CFX/bin/cfx5solve.exe
ANSYS_CFX_PRE=D:/Program Files/ANSYS Inc/v251/CFX/bin/cfx5pre.exe
