      "script": "# 外伸梁弯矩图计算\n# 结构：A(铰支) -- L=280 -- B(铰支) -- l=60 -- C(自由端，悬臂)\n# 已知：FRA = 3200 N（向上），L=280 mm，l=60 mm\n# 假设载荷 P 在悬臂端 C 向下\n\nFRA = 3200  # N\nL = 280     # mm\nl = 60      # mm\n\n# 对 B 取矩：FRA * L = P * l\nP = FRA * L / l  # 悬臂端载荷，N\n\n# 竖向力平衡：FRA + FRB = P\nFRB = P - FRA\n\n# 弯矩关键点\nM_A = 0.0                    # 铰支端 A\nM_B = FRA * L                # B 处（两侧连续），N·mm\nM_C = 0.0                    # 自由端 C\n\n# AB 段最大弯矩（线性分布，在 B 处最大）\nM_AB_max = M_B\n\n# 弯矩分布（取几个点）\nx_points = [0, 70, 140, 210, 280, 280, 310, 340]\nM_points = []\nfor x in x_points:\n    if x <= L:\n        M = FRA * x\n    else:\n        # BC 段：M(y) = P*(l - y)，y = x - L\n        y = x - L\n        M = P * (l - y)\n    M_points.append(M)\n\noutputs = {\n    'P': P,\n    'FRB': FRB,\n    'M_A': M_A,\n    'M_B': M_B,\n    'M_C': M_C,\n    'M_AB_max': M_AB_max,\n    'x_points_mm': x_points,\n    'M_points_Nmm': M_points\n}",
      "created_at": "2026-08-15T21:59:37.937732Z"
    }
  },
