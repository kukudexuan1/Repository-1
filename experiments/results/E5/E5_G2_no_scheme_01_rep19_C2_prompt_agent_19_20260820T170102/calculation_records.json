    "stale": false,
    "stale_reason": "",
    "notes": "",
    "script": "\n# 机械设计（第十版）表10-5：20°标准压力角直齿轮齿形系数 Y_Fa 与应力校正系数 Y_Sa（按齿数 z）\ntable = {\n    17: (2.97, 1.52), 18: (2.91, 1.53), 19: (2.85, 1.54), 20: (2.80, 1.55),\n    21: (2.76, 1.56), 22: (2.72, 1.57), 24: (2.65, 1.58), 26: (2.60, 1.59),\n    28: (2.55, 1.61), 30: (2.52, 1.62), 35: (2.45, 1.65), 40: (2.40, 1.67),\n    45: (2.35, 1.68), 50: (2.32, 1.70), 60: (2.28, 1.73), 70: (2.24, 1.75),\n    80: (2.22, 1.77), 90: (2.20, 1.78), 100: (2.18, 1.79), 150: (2.14, 1.83),\n    200: (2.12, 1.87), 400: (2.06, 1.97),\n}\ndef interp(z):\n    if z in table:\n        return table[z]\n    keys = sorted(table.keys())\n    for i in range(len(keys) - 1):\n        if keys[i] <= z <= keys[i+1]:\n            z0, z1 = keys[i], keys[i+1]\n            yf = table[z0][0] + (z - z0) / (z1 - z0) * (table[z1][0] - table[z0][0])\n            ys = table[z0][1] + (z - z0) / (z1 - z0) * (table[z1][1] - table[z0][1])\n            return yf, ys\n    return None\n\nY_Fa1, Y_Sa1 = interp(24)\nY_Fa2, Y_Sa2 = interp(96)\noutputs = {'Y_Fa1': Y_Fa1, 'Y_Sa1': Y_Sa1, 'Y_Fa2': Y_Fa2, 'Y_Sa2': Y_Sa2}\n",
    "created_at": "2026-08-20T17:04:25.510297Z"
  },
