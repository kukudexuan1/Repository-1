      "source": "机械设计（第十版）表13-5 深沟球轴承系数",
      "engine": "sympy",
      "depends_on": [],
      "stale": false,
      "stale_reason": "",
      "notes": "",
      "script": "# 深沟球轴承 6210\nC0r = 23200  # N\nFa = 1200    # N\nFr = 8500    # N\n\n# Fa/C0r\nFa_C0r = Fa / C0r\n\n# 表13-5 深沟球轴承：Fa/C0r → e 的插值节点\n# (Fa/C0r, e)\ntable = [\n    (0.025, 0.22),\n    (0.040, 0.24),\n    (0.070, 0.27),\n    (0.130, 0.31),\n    (0.250, 0.37),\n    (0.500, 0.44),\n]\n\n# 线性插值求 e\ne = None\nfor i in range(len(table) - 1):\n    x0, y0 = table[i]\n    x1, y1 = table[i+1]\n    if x0 <= Fa_C0r <= x1:\n        e = y0 + (y1 - y0) * (Fa_C0r - x0) / (x1 - x0)\n        break\n\nif e is None:\n    e = table[-1][1]  # 超出范围取最右\n\n# 判断 X, Y\nFa_Fr = Fa / Fr\n\nif Fa_Fr <= e:\n    X = 1.0\n    Y = 0.0\nelse:\n    # 需要查表取 Y 值（但 Fa/Fr > e 时 Y 也依赖 Fa/C0r）\n    X = 0.56\n    # Y 也需插值，这里先算 e 对应的 Y 近似\n    Y_table = {\n        0.025: 2.0,\n        0.040: 1.8,\n        0.070: 1.6,\n        0.130: 1.4,\n        0.250: 1.2,\n        0.500: 1.0,\n    }\n    # 插值 Y\n    y_keys = sorted(Y_table.keys())\n    Y = None\n    for i in range(len(y_keys) - 1):\n        x0, x1 = y_keys[i], y_keys[i+1]\n        if x0 <= Fa_C0r <= x1:\n            Y = Y_table[x0] + (Y_table[x1] - Y_table[x0]) * (Fa_C0r - x0) / (x1 - x0)\n            break\n    if Y is None:\n        Y = Y_table[y_keys[-1]]\n\noutputs = {\n    'Fa_C0r': round(Fa_C0r, 6),\n    'e': round(e, 4),\n    'Fa_Fr': round(Fa_Fr, 4),\n    'X': X,\n    'Y': Y,\n    'judgment': 'Fa/Fr <= e, X=1, Y=0' if Fa_Fr <= e else 'Fa/Fr > e, X=0.56, Y需插值'\n}",
      "created_at": "2026-08-15T21:28:07.915800Z"
    },
