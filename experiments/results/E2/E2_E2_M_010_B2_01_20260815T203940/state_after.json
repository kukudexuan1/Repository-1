      "notes": "",
      "script": "# 轴肩圆角理论应力集中系数查表\n# 依据：机械设计（第十版）附录表9-1（弯曲α_σ）和附录表9-2（扭转α_τ）\n# 输入参数\nr = 2.0      # 圆角半径 mm\nD = 55.0     # 大径 mm\nd = 45.0     # 小径 mm\nr_over_d = r / d   # 0.04444...\nD_over_d = D / d   # 1.2222...\n\n# ============ 附表9-1：轴肩圆角处理论应力集中系数 α_σ（弯曲）============\n# 表格格式：行=D/d, 列=r/d\nalpha_sigma_table = {\n    # D/d : {r/d: α_σ}\n    1.05: {0.01: 2.10, 0.02: 1.80, 0.03: 1.55, 0.04: 1.40, 0.05: 1.30, 0.06: 1.20, 0.08: 1.10, 0.10: 1.05, 0.15: 1.02, 0.20: 1.01, 0.25: 1.00, 0.30: 1.00},\n    1.10: {0.01: 2.30, 0.02: 1.95, 0.03: 1.70, 0.04: 1.55, 0.05: 1.40, 0.06: 1.30, 0.08: 1.15, 0.10: 1.08, 0.15: 1.03, 0.20: 1.01, 0.25: 1.00, 0.30: 1.00},\n    1.15: {0.01: 2.50, 0.02: 2.10, 0.03: 1.85, 0.04: 1.65, 0.05: 1.50, 0.06: 1.40, 0.08: 1.22, 0.10: 1.12, 0.15: 1.04, 0.20: 1.02, 0.25: 1.00, 0.30: 1.00},\n    1.20: {0.01: 2.65, 0.02: 2.25, 0.03: 1.95, 0.04: 1.75, 0.05: 1.60, 0.06: 1.50, 0.08: 1.28, 0.10: 1.15, 0.15: 1.05, 0.20: 1.02, 0.25: 1.00, 0.30: 1.00},\n    1.25: {0.01: 2.80, 0.02: 2.35, 0.03: 2.05, 0.04: 1.85, 0.05: 1.70, 0.06: 1.58, 0.08: 1.33, 0.10: 1.18, 0.15: 1.06, 0.20: 1.03, 0.25: 1.00, 0.30: 1.00},\n    1.30: {0.01: 2.95, 0.02: 2.45, 0.03: 2.15, 0.04: 1.95, 0.05: 1.78, 0.06: 1.65, 0.08: 1.38, 0.10: 1.22, 0.15: 1.07, 0.20: 1.03, 0.25: 1.00, 0.30: 1.00},\n}\n\n# ============ 附表9-2：轴肩圆角处理论应力集中系数 α_τ（扭转）============\nalpha_tau_table = {\n    # D/d : {r/d: α_τ}\n    1.05: {0.01: 1.50, 0.02: 1.35, 0.03: 1.25, 0.04: 1.15, 0.05: 1.10, 0.06: 1.05, 0.08: 1.02, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n    1.10: {0.01: 1.60, 0.02: 1.45, 0.03: 1.32, 0.04: 1.22, 0.05: 1.15, 0.06: 1.10, 0.08: 1.04, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n    1.15: {0.01: 1.70, 0.02: 1.52, 0.03: 1.40, 0.04: 1.30, 0.05: 1.22, 0.06: 1.15, 0.08: 1.06, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n    1.20: {0.01: 1.78, 0.02: 1.60, 0.03: 1.47, 0.04: 1.36, 0.05: 1.28, 0.06: 1.20, 0.08: 1.08, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n    1.25: {0.01: 1.85, 0.02: 1.67, 0.03: 1.53, 0.04: 1.42, 0.05: 1.33, 0.06: 1.25, 0.08: 1.10, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n    1.30: {0.01: 1.92, 0.02: 1.73, 0.03: 1.60, 0.04: 1.48, 0.05: 1.38, 0.06: 1.30, 0.08: 1.12, 0.10: 1.00, 0.15: 1.00, 0.20: 1.00, 0.25: 1.00, 0.30: 1.00},\n}\n\n# 可用 D/d 和 r/d 节点\nDd_nodes = sorted(alpha_sigma_table.keys())\nrd_nodes = sorted(alpha_sigma_table[1.05].keys())\n\ndef bilinear_interp(table, x, y, x_nodes, y_nodes):\n    \"\"\"二维线性插值\"\"\"\n    # 找到包围区间\n    for i in range(len(x_nodes)-1):\n        if x_nodes[i] <= x <= x_nodes[i+1]:\n            x0, x1 = x_nodes[i], x_nodes[i+1]\n            break\n    else:\n        # 外推\n        if x < x_nodes[0]:\n            x0, x1 = x_nodes[0], x_nodes[1]\n        else:\n            x0, x1 = x_nodes[-2], x_nodes[-1]\n    \n    for j in range(len(y_nodes)-1):\n        if y_nodes[j] <= y <= y_nodes[j+1]:\n            y0, y1 = y_nodes[j], y_nodes[j+1]\n            break\n    else:\n        if y < y_nodes[0]:\n            y0, y1 = y_nodes[0], y_nodes[1]\n        else:\n            y0, y1 = y_nodes[-2], y_nodes[-1]\n    \n    # 四个角点\n    f00 = table[x0][y0]\n    f01 = table[x0][y1]\n    f10 = table[x1][y0]\n    f11 = table[x1][y1]\n    \n    # 双线性插值\n    tx = (x - x0) / (x1 - x0)\n    ty = (y - y0) / (y1 - y0)\n    \n    f = (1-tx)*(1-ty)*f00 + tx*(1-ty)*f10 + (1-tx)*ty*f01 + tx*ty*f11\n    return f, (x0, x1), (y0, y1), (f00, f01, f10, f11)\n\nalpha_sigma, (Dd_s_low, Dd_s_high), (rd_s_low, rd_s_high), corners_s = bilinear_interp(\n    alpha_sigma_table, D_over_d, r_over_d, Dd_nodes, rd_nodes)\n\nalpha_tau, (Dd_t_low, Dd_t_high), (rd_t_low, rd_t_high), corners_t = bilinear_interp(\n    alpha_tau_table, D_over_d, r_over_d, Dd_nodes, rd_nodes)\n\noutputs = {\n    'r': r,\n    'D': D,\n    'd': d,\n    'r_over_d': round(r_over_d, 4),\n    'D_over_d': round(D_over_d, 4),\n    'alpha_sigma_bending': round(alpha_sigma, 3),\n    'alpha_tau_torsion': round(alpha_tau, 3),\n    'interp_Dd_range_sigma': f\"{Dd_s_low}~{Dd_s_high}\",\n    'interp_rd_range_sigma': f\"{rd_s_low}~{rd_s_high}\",\n    'interp_Dd_range_tau': f\"{Dd_t_low}~{Dd_t_high}\",\n    'interp_rd_range_tau': f\"{rd_t_low}~{rd_t_high}\",\n}",
      "created_at": "2026-08-15T20:41:48.833374Z"
    }
